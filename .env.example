# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Without GEMINI_API_KEY the API is search-only: /ask returns the best passages and no AI answer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
DATABASE_URL=postgresql://niyam:niyam@localhost:5433/niyam
# Optional. "file" serves search from data/index/e5-passages.npz instead of embedding the passages at first start.
NIYAM_INDEX=
# Optional per-client limit on /ask, e.g. 10/minute,100/day (empty: no limit).
NIYAM_ASK_RATE_LIMIT=
# Optional. 1 loads the model and passages at start-up instead of on the first request.
NIYAM_PRELOAD=
